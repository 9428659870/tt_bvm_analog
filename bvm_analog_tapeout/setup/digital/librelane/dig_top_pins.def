    - bg_trim[2] + NET bg_trim[2] + DIRECTION OUTPUT + USE SIGNAL
      + PORT
        + LAYER met2 ( -140 0 ) ( 140 1000 )
        + PLACED ( 155000 0 ) S ;
    - bg_trim[3] + NET bg_trim[3] + DIRECTION OUTPUT + USE SIGNAL
