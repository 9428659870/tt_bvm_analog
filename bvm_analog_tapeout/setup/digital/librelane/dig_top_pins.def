    - bg_ok_combined + NET bg_ok_combined + DIRECTION OUTPUT + USE SIGNAL
      + PORT
        + LAYER met2 ( -140 0 ) ( 140 1000 )
        + PLACED ( 180000 0 ) S ;
END PINS
END DESIGN
