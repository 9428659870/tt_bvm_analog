VERSION 5.8 ;
DIVIDERCHAR "/" ;
BUSBITCHARS "[]" ;
DESIGN dig_top ;
UNITS DISTANCE MICRONS 1000 ;
DIEAREA ( 0 0 ) ( 190000 130000 ) ;
PINS 33 ;
    - spi_miso + NET spi_miso + DIRECTION OUTPUT + USE SIGNAL
      + PORT
        + LAYER met2 ( -140 -1000 ) ( 140 0 )
        + PLACED ( 46700 130000 ) N ;
    - pwm1_out + NET pwm1_out + DIRECTION OUTPUT + USE SIGNAL
      + PORT
        + LAYER met2 ( -140 -1000 ) ( 140 0 )
        + PLACED ( 71540 130000 ) N ;
    - pwm0_out + NET pwm0_out + DIRECTION OUTPUT + USE SIGNAL
      + PORT
        + LAYER met2 ( -140 -1000 ) ( 140 0 )
