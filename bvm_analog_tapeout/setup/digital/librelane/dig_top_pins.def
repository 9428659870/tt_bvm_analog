    - spi_sck + NET spi_sck + DIRECTION INPUT + USE SIGNAL
      + PORT
        + LAYER met2 ( -140 -1000 ) ( 140 0 )
        + PLACED ( 88100 130000 ) N ;
    - spi_mosi + NET spi_mosi + DIRECTION INPUT + USE SIGNAL
      + PORT
        + LAYER met2 ( -140 -1000 ) ( 140 0 )
        + PLACED ( 93620 130000 ) N ;
    - spi_cs_n + NET spi_cs_n + DIRECTION INPUT + USE SIGNAL
