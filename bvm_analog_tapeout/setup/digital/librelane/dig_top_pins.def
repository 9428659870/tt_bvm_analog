        + LAYER met2 ( -140 0 ) ( 140 1000 )
        + PLACED ( 170000 0 ) S ;
    - bg_valid + NET bg_valid + DIRECTION OUTPUT + USE SIGNAL
      + PORT
        + LAYER met2 ( -140 0 ) ( 140 1000 )
