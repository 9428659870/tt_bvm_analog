        + LAYER met2 ( -140 0 ) ( 140 1000 )
        + PLACED ( 57000 0 ) S ;
    - bias_trim[0] + NET bias_trim[0] + DIRECTION OUTPUT + USE SIGNAL
      + PORT
        + LAYER met2 ( -140 0 ) ( 140 1000 )
        + PLACED ( 63440 0 ) S ;
    - bias_trim[1] + NET bias_trim[1] + DIRECTION OUTPUT + USE SIGNAL
      + PORT
        + LAYER met2 ( -140 0 ) ( 140 1000 )
        + PLACED ( 68440 0 ) S ;
    - bias_trim[2] + NET bias_trim[2] + DIRECTION OUTPUT + USE SIGNAL
      + PORT
        + LAYER met2 ( -140 0 ) ( 140 1000 )
        + PLACED ( 74440 0 ) S ;
    - bias_trim[3] + NET bias_trim[3] + DIRECTION OUTPUT + USE SIGNAL
