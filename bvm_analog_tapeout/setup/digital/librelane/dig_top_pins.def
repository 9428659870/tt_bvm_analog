    - cap + NET cap + DIRECTION OUTPUT + USE SIGNAL
      + PORT
        + LAYER met2 ( -140 0 ) ( 140 1000 )
        + PLACED ( 125000 0 ) S ;
    - phi1 + NET phi1 + DIRECTION OUTPUT + USE SIGNAL
      + PORT
        + LAYER met2 ( -140 0 ) ( 140 1000 )
