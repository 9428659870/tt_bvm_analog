        + LAYER met2 ( -140 -1000 ) ( 140 0 )
        + PLACED ( 126740 130000 ) N ;
    - dbl_en + NET dbl_en + DIRECTION OUTPUT + USE SIGNAL
      + PORT
        + LAYER met2 ( -140 0 ) ( 140 1000 )
        + PLACED ( 43780 0 ) S ;
    - pwm0_clk + NET pwm0_clk + DIRECTION INPUT + USE SIGNAL
      + PORT
        + LAYER met2 ( -140 0 ) ( 140 1000 )
        + PLACED ( 48000 0 ) S ;
    - pwm0_clk_sel + NET pwm0_clk_sel + DIRECTION OUTPUT + USE SIGNAL
