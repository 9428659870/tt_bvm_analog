# ============================================================
# Project xschemrc
#
# Every analog/<block>/xschem/ directory has a one-line xschemrc that
# sources this file, so just run `xschem <block>.sch` from there.
# From anywhere else use: xschem --rcfile <path to this file> ...
# (xschem has no XSCHEMRC environment variable.)
#
# It sources the PDK's own xschemrc first, then adds this project's
# blocks so cross-block symbols resolve.
# ============================================================

# xschem's own library (devices/ipin.sym etc.). Schematics reference
# symbols as "devices/x.sym", so the *parent* xschem_library directory
# must be on the path, not just xschem_library/devices.
append XSCHEM_LIBRARY_PATH :${XSCHEM_SHAREDIR}/xschem_library
append XSCHEM_LIBRARY_PATH :${XSCHEM_SHAREDIR}/xschem_library/devices

# PDK: use $PDK_ROOT if exported, otherwise fall back to the volare
# install in the home directory.
if { [info exists ::env(PDK_ROOT)] } {
    set PDK_ROOT $::env(PDK_ROOT)
} elseif { [file exists $::env(HOME)/.volare/sky130A] } {
    set PDK_ROOT $::env(HOME)/.volare
    set ::env(PDK_ROOT) $PDK_ROOT
}
set PDK sky130A
set ::env(PDK) $PDK

if { [info exists PDK_ROOT] && [file exists $PDK_ROOT/$PDK/libs.tech/xschem/xschemrc] } {
    source $PDK_ROOT/$PDK/libs.tech/xschem/xschemrc
} else {
    puts stderr "xschemrc: no sky130A PDK found (set PDK_ROOT). sky130 symbols will not resolve."
}

# Project blocks, so e.g. pwm_dac can instance out_buf.
set PROJ_ROOT [file normalize [file join [file dirname [info script]] .. ..]]
foreach blk {bandgap bias_gen clk_doubler out_buf pwm_dac tt_analog_top analog_mux} {
    set p [file join $PROJ_ROOT analog $blk xschem]
    if { [file isdirectory $p] } {
        append XSCHEM_LIBRARY_PATH ":$p"
    }
}

set netlist_dir [file join $PROJ_ROOT obj]
